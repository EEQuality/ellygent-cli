# Ellygent CLI Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: Add .env to .gitignore - never commit secrets!

# Personal Access Token (recommended for CLI authentication)
# Generate at: https://ellygent.com/account (Account → Personal Access Tokens)
ELLYGENT_PAT=elly_pat_your_token_here

# Ellygent API URL (optional - can be set via --api-url flag)

# Production: https://www.ellygent.com/api/
ELLYGENT_API_URL=https://www.ellygent.com/api/

# Alternative: Email/Password authentication (not recommended for automation)
# ELLYGENT_PASSWORD=your_password_here
