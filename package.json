{
  "name": "@ellygent/cli",
  "version": "0.1.1",
  "description": "Ellygent command line tools for downloading AI-optimized engineering context packages.",
  "type": "module",
  "bin": {
    "ellygent": "./dist/index.js",
    "ellygent-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "build:release": "npm run build",
    "publish:frontend": "node scripts/publish-to-frontend.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ellygent",
    "requirements",
    "systems-engineering",
    "cli",
    "context",
    "engineering",
    "ai",
    "requirements-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ellygent/ellygent-cli.git"
  },
  "bugs": {
    "url": "https://github.com/ellygent/ellygent-cli/issues"
  },
  "homepage": "https://github.com/ellygent/ellygent-cli#readme",
  "author": "Ellygent",
  "dependencies": {
    "@inquirer/prompts": "^5.5.0",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^20.14.11",
    "adm-zip": "^0.5.16",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "ora": "^5.4.1",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "vitest": "^2.0.0"
  },
  "license": "UNLICENSED"
}
