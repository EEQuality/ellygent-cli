{
  "name": "@ellygent/cli",
  "version": "0.1.3",
  "description": "Ellygent command line tools for downloading AI-optimized engineering context packages.",
  "type": "module",
  "bin": {
    "ellygent": "./dist/index.js",
    "ellygent-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "build:release": "npm run build",
    "publish:frontend": "node scripts/publish-to-frontend.js",
    "test:executable": "node scripts/executable-regressions.mjs",
    "test:installed": "node scripts/installed-regressions.mjs",
    "test:installer-integrity": "node scripts/install-integrity.node-test.mjs",
    "gate:release-security": "node scripts/release-security-gate.mjs",
    "test:release-security-policy": "node scripts/release-security-gate.node-test.mjs",
    "test:checkout-bytes": "python3 scripts/test-checkout-bytes.py"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ellygent",
    "requirements",
    "systems-engineering",
    "cli",
    "context",
    "engineering",
    "ai",
    "requirements-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ellygent/ellygent-cli.git"
  },
  "bugs": {
    "url": "https://github.com/ellygent/ellygent-cli/issues"
  },
  "homepage": "https://github.com/ellygent/ellygent-cli#readme",
  "author": "Ellygent",
  "dependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^20.14.11",
    "adm-zip": "0.6.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "ora": "^5.4.1",
    "typescript": "^5.5.3",
    "@inquirer/input": "2.3.0",
    "@inquirer/password": "2.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "vitest": "4.1.12",
    "vite": "6.4.6"
  },
  "license": "UNLICENSED"
}
